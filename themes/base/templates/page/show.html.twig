{% extends 'layout.html.twig' %}

{% block title %}{{ page.isHome ? settings.organizationName ~ (settings.tagline ? ' — ' ~ settings.tagline : '') : page.title ~ ' · ' ~ settings.organizationName }}{% endblock %}

{% set seo = {
    title: page.isHome ? settings.organizationName : page.title,
    description: page.metaDescription ?: settings.tagline,
    jsonld: page.isHome ? [ld().organization(settings), ld().website(settings)] : [ld().breadcrumbs([[settings.organizationName, url('app_home')], [page.title, url('app_page', {slug: page.slug})]])],
} %}

{% block body_class %}page page--{{ page.isHome ? 'home' : page.slug }}{% endblock %}

{# Blocks are full width; each block centres its own content. #}
{% block main %}
    {% if not page.isHome and (page.enabledBlocks is empty or page.enabledBlocks|first.type != 'hero') %}
        <div class="container"><h1 class="page-title">{{ page.title }}</h1></div>
    {% endif %}
    {% for block in page.enabledBlocks %}
        {{ render_block(block) }}
    {% endfor %}
{% endblock %}
