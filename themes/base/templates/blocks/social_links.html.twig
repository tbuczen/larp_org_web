<section class="block block--social-links" id="block-{{ block.id }}">
    <div class="container container--narrow center">
        {% if settings.title %}<h2 class="block__title">{{ settings.title }}</h2>{% endif %}
        {% if settings.text %}<p class="block__intro">{{ settings.text }}</p>{% endif %}
        {% include 'partials/_social.html.twig' with {site: site} %}
        {% if settings.show_email and site.contactEmail %}
            <p class="contact-email"><twig:ux:icon name="lucide:mail" aria-hidden="true" /> <a href="mailto:{{ site.contactEmail }}">{{ site.contactEmail }}</a></p>
        {% endif %}
    </div>
</section>
