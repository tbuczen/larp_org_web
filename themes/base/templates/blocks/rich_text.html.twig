<section class="block block--rich-text" id="block-{{ block.id }}">
    <div class="container{{ settings.width == 'narrow' ? ' container--narrow' : '' }}">
        {% if settings.title %}<h2 class="block__title">{{ settings.title }}</h2>{% endif %}
        <div class="prose">{{ settings.content|raw }}</div>
    </div>
</section>
