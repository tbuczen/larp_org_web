<section class="block block--matcher-teaser" id="block-{{ block.id }}">
    <div class="container">
        <div class="teaser">
            <div class="teaser__scale" aria-hidden="true">
                <span>−2</span><span>−1</span><span>0</span><span>+1</span><span>+2</span>
            </div>
            <div>
                <h2 class="block__title">{{ settings.title ?: 'matcher.title'|trans }}</h2>
                <p>{{ settings.text ?: 'matcher.intro'|trans }}</p>
                <a class="button button--primary" href="{{ path('app_characters') }}">{{ settings.button_label ?: 'block.matcher_teaser.button'|trans }} <twig:ux:icon name="lucide:arrow-right" aria-hidden="true" /></a>
            </div>
        </div>
    </div>
</section>
