{% extends 'layout.html.twig' %}

{% block title %}{{ 'character.title'|trans }} · {{ larp.name }} · {{ settings.organizationName }}{% endblock %}

{% block content %}
    <nav class="breadcrumbs"><a href="{{ path('app_larp_show', {slug: larp.slug}) }}">← {{ larp.name }}</a></nav>
    <h1 class="page-title">{{ 'matcher.title'|trans }} <small>{{ larp.name }} · {{ edition.name }}</small></h1>
    <p class="lead">{{ 'matcher.intro'|trans }}</p>

    <twig:CharacterMatcher larpSlug="{{ larp.slug }}" />
{% endblock %}
