{% extends 'layout.html.twig' %}

{% set seo = {
    description: larp.teaser ?? larp.description,
    image: seo_image(larp),
    image_alt: larp.coverImageAlt,
    jsonld: [ld().larpBreadcrumbs(settings, larp)]|merge(larp.sortedEditions|filter(e => not e.past)|map(e => ld().event(e, settings))),
} %}
{% block title %}{{ larp.name }} · {{ settings.organizationName }}{% endblock %}
{% block theme_overrides %}{% include 'partials/_larp_colors.html.twig' with {larp: larp} %}{% endblock %}

{% block content %}
    <article class="larp-page">
        {% include 'larp/_hero.html.twig' with {is_current: true} %}

        {% if larp.description %}
            <section class="prose">{{ larp.description|raw }}</section>
        {% endif %}

        {% if characters is not empty %}
            <section class="larp-characters">
                <div class="section-head">
                    <h2>{{ 'character.title'|trans }}</h2>
                    <a href="{{ path('app_edition_characters', {slug: larp.slug, edition: edition.slug}) }}">{{ 'character.see_all'|trans({count: characters|length}) }}</a>
                </div>
                <div class="card-grid card-grid--small">
                    {% for character in characters|slice(0, 6) %}
                        {% include 'character/_card.html.twig' %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if galleries is not empty %}
            <section class="larp-galleries">
                <div class="section-head">
                    <h2>{{ 'gallery.larp_title'|trans }}</h2>
                </div>
                <div class="card-grid card-grid--small gallery-cards">
                    {% for gallery in galleries %}
                        {% include 'gallery/_card.html.twig' with {show_larp: false} %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if larp.editionCount > 1 and not larp.initiative %}
            <section class="larp-editions">
                <h2>{{ 'larp.editions'|trans }}</h2>
                <div class="card-grid card-grid--small edition-cards">
                    {% for e in larp.sortedEditions|reverse %}
                        {% include 'larp/_edition_card.html.twig' with {
                            edition_item: e,
                            character_count: characterCounts[e.id] ?? 0,
                            edition_galleries: galleries|filter(g => g.edition is same as(e)),
                            current: e is same as(edition),
                        } %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </article>
{% endblock %}
