{% extends 'layout.html.twig' %}

{#
    Temporary home page. The real front page is built from page blocks
    and rendered by the active theme (see issues #13, #15 and #17).
#}
{% block content %}
    <section class="placeholder-home">
        <h1>{{ settings.organizationName }}</h1>
        {% if settings.tagline %}<p class="tagline">{{ settings.tagline }}</p>{% endif %}
        {% if settings.about %}<div class="about">{{ settings.about|raw }}</div>{% endif %}
    </section>

    {% if current is not empty %}
        <section class="larp-section">
            <div class="section-head">
                <h2>{{ 'home.current'|trans }}</h2>
                <a href="{{ path('app_larp_index') }}">{{ 'home.all_larps'|trans }}</a>
            </div>
            <div class="card-grid">
                {% for larp in current %}
                    {% include 'larp/_card.html.twig' %}
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endblock %}
